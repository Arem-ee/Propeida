NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Paystack (required for payments)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_SECRET_KEY=your_paystack_secret_key

# Base URL (required for Paystack callback)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Google Analytics 4 (required for GA4 tag)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-8HCKS2QCZL

# Resend (used only by scripts/send-founder-email.mjs, manual --send)
RESEND_API_KEY=your_resend_api_key
# Verified sender address; must match a domain/email verified in Resend
EMAIL_FROM=The Propeida Team <onboarding@resend.dev>
